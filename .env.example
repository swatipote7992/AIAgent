OPENAI_API_KEY=your-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_KEY=your-search-admin-key
AZURE_SEARCH_INDEX=insurance-policies-v2
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1-mini
CORS_ORIGINS=http://localhost:5173
API_KEY=leave-empty-for-local-development
LLM_MAX_TOKENS=500
# Which system prompt version to use (v1, v2, v3). Leave empty for the latest.
SYS_PROMPT_VERSION=v2
# Which version of the "carry on" instruction to use when a reply is cut off by LLM_MAX_TOKENS (v1). Leave empty for the latest.
CONTINUE_PROMPT_VERSION=
# Timeouts (seconds) and retries per layer; the values shown are the defaults.
LLM_TIMEOUT_SECONDS=25
LLM_MAX_RETRIES=1
EMBEDDING_TIMEOUT_SECONDS=10
EMBEDDING_MAX_RETRIES=2
SEARCH_TIMEOUT_SECONDS=10
SEARCH_MAX_RETRIES=2
# One time budget (seconds) for the whole /api/ask request. Calls are retried inside the SDK clients only (the settings above); the request itself is not retried.
REQUEST_TIMEOUT_SECONDS=60
# Limits on /api/ask for the public site. Per visitor (one network address) and all visitors together per day.
# Set RATE_LIMIT_ENABLED=false to switch them off, for example while testing locally.
RATE_LIMIT_PER_VISITOR=6/minute;60/hour
RATE_LIMIT_ALL_VISITORS_PER_DAY=1000/day
RATE_LIMIT_ENABLED=true
# Optional second deployments used when the primary keeps failing. Leave empty for none.
# The embedding fallback must be the SAME model as the primary (another model does not match the index).
AZURE_OPENAI_CHAT_FALLBACK_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_FALLBACK_DEPLOYMENT=
# Azure AI Foundry project endpoint (format https://<resource>.services.ai.azure.com/api/projects/<project>). Dev-only,
# used by evals/run_evals.py: when set, eval judging goes through evaluate() and shows up on the project's Evaluation
# page instead of only being scored locally. Leave empty to judge locally only (the old behaviour).
AZURE_AI_PROJECT_ENDPOINT=
# Azure AI Content Safety endpoint (format https://<resource>.cognitiveservices.azure.com), used by
# guardrails/prompt_shields.py to check a question for jailbreak/prompt-injection attempts before it reaches the
# chat model. Same multi-service account as AZURE_OPENAI_ENDPOINT, so AZURE_OPENAI_API_KEY is reused for this call
# too. Leave empty to skip this check (the deterministic regex checks in guardrails/input_guardrails.py still run).
AZURE_CONTENT_SAFETY_ENDPOINT=
PROMPT_SHIELDS_TIMEOUT_SECONDS=5